void test_nested_operator_boundaries() {
    shared UserSession? session = cast<UserSession?>(new UserSession("root_user", null));

    string[] assigned_roles = (session != null ? session?.roles : null) ?? ["default_user"];

    session?.roles = ["admin", "superadmin"];

    string[] current_roles = session?.roles ?? get_default_roles();

    session = null;
}

