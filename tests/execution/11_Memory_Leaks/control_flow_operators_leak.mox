ref class UserSession {
    public string username;
    public string[]? roles;

    constructor(string username, string[]? roles) {
        this.username = username;
        this.roles = roles;
    }
}

string[] get_default_roles() {
    return ["guest", "unverified"];
}

string get_fallback_string(int choice) {
    return choice > 0 ? "fallback_positive" : "fallback_negative";
}

